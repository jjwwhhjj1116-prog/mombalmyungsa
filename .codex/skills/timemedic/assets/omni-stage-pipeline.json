{
  "schema_version": "timemedic.omni-stage-pipeline.v1",
  "id": "episode-id",
  "brand": "몸의 발명사",
  "production_mode": "stage_gated_tts_owned_omni_hybrid_opening_i2v_then_t2v",
  "benchmark_reference": {
    "url": "https://www.youtube.com/watch?v=ReUyaMDGj9o",
    "adopted": [
      "topic candidates before script",
      "separate narration and visual prompts",
      "Korean review prompt plus English generation prompt",
      "candidate clips and best-segment harvesting",
      "TTS-owned editing",
      "optical flow only for necessary duration repair"
    ],
    "rejected": [
      "generated readable Korean text",
      "720p final delivery",
      "two candidates for every low-risk unit",
      "whole generated clip used by default"
    ]
  },
  "topic_selection": {
    "minimum_candidates": 10,
    "score_range": [0, 5],
    "dimensions": [
      "present_familiarity",
      "hidden_contradiction",
      "visual_mechanism",
      "human_stakes",
      "reversal_strength",
      "evidence_strength",
      "current_relevance",
      "originality"
    ],
    "hard_reject": {
      "evidence_strength_below": 4,
      "visual_mechanism_below": 3,
      "medical_safety_language_missing": true
    },
    "finalists": 3,
    "selected_topics": 1
  },
  "invariants": {
    "one_sentence_one_timing_owner": true,
    "final_timing_master": "final_tts_word_alignment",
    "next_sentence_meaning_before_boundary": false,
    "generated_text_policy": "blank_plates_only",
    "paid_generation_before_script_approval": false,
    "batch_generation_before_pilot_qa_pass": false,
    "final_width": 1080,
    "final_height": 1920,
    "duration_tolerance_frames": 1,
    "caption_timing_source": "final_tts_word_alignment",
    "caption_even_split_forbidden": true,
    "flow_reference_grammar_lock_required": true,
    "shorts_thumbnail_route": "approved_frame_zero_then_select_frame",
    "thumbnail_is_video_frame_zero": true,
    "thumbnail_contract_stage": "06_storyboard",
    "thumbnail_final_pixels_before_generation": true,
    "thumbnail_mobile_qa_before_generation": true,
    "textless_opening_image_before_generation": true,
    "first_two_seconds_discontinuity_count_max": 0,
    "ai_use_disclosure_for_flow_reconstruction": "yes"
    ,"native_audio_visible_event_only": true
    ,"native_audio_sync_tolerance_frames": 2
    ,"continuous_motion_carrier_required": true
    ,"commerce_route_required": true
  },
  "script_contract": {
    "beats": 16,
    "default_profile": "short_50_58",
    "profiles": {
      "short_50_58": {
        "target_seconds": [50, 58],
        "sentence_count": [22, 30],
        "audience_timeline_seconds": [[0, 5], [5, 15], [15, 27], [27, 40], [40, 50], [50, 58]]
      },
      "extended_60_80": {
        "target_seconds": [60, 80],
        "sentence_count": [24, 36]
      }
    },
    "order": [
      "present_result",
      "familiar_assumption",
      "verified_contradiction",
      "past_problem",
      "failed_solution",
      "secondary_crisis",
      "double_bind",
      "emotional_impasse",
      "anomalous_observation",
      "question_reframe",
      "concrete_action",
      "verified_result",
      "cost_before_triumph",
      "proof",
      "present_return",
      "meaning"
    ],
    "review_passes": [
      "medical_and_historical_fact_review",
      "spoken_korean_pronunciation_and_rhythm_review"
    ],
    "user_revision_required": true,
    "final_human_approval_required": true
  },
  "visual_generation": {
    "engine": "Google Flow",
    "model": "Omni Flash",
    "forbidden_model": "Veo 3.1 Quality",
    "mode": "text_to_video",
    "opening_mode_override": "image_to_video_from_approved_textless_thumbnail",
    "remaining_units_mode": "text_to_video",
    "aspect_ratio": "9:16",
    "seconds_per_unit": 8,
    "sentences_per_unit": [2, 3],
    "default_candidate_count": 1,
    "high_risk_candidate_count": 2,
    "high_risk_units": [
      "hook",
      "reversal",
      "complex_hand_action",
      "internal_body_mechanism",
      "continuity_critical"
    ],
    "pilot_units": ["hook", "mechanism_or_reversal"],
    "prompt_views": ["ko_review", "en_generation"],
    "candidate_selection": "best_segment_harvest",
    "harvest_seconds_per_sentence": [1, 3],
    "optical_flow_policy": "exceptional_duration_repair_only"
  },
  "typography": {
    "font_family": "Gmarket Sans Bold",
    "font_size_px": 100,
    "stroke_width_px": 30,
    "stroke_color": "#000000",
    "shadow_required": true,
    "manual_line_breaks": true,
    "anchor_x_px": 540,
    "anchor_y_px": 1200,
    "anchor_y_ratio": 0.625,
    "anchor_reference": "10_of_16_from_top",
    "block_anchor": "center"
  },
